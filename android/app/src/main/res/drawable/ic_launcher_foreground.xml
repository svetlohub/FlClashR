  <!-- Left fin -->
  <path
      android:fillColor="#FFE0FFAA"
      android:pathData="M44,48 L36,64 L44,62Z"/>

  <!-- Right fin -->
  <path
      android:fillColor="#FFE0FFAA"
      android:pathData="M64,48 L72,64 L64,62Z"/>

  <!-- Porthole window — sky blue fill -->
  <path
      android:fillColor="#FF00ADEE"
      android:pathData="M54,38 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"/>

  <!-- Window highlight -->
