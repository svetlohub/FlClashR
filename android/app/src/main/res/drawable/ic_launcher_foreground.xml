    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <!-- Safe zone inset: 18dp each side, content in 72x72 centered at 54,54 -->

  <!-- Rocket body — pointed top, wide base with fins -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="
        M54,18
        C54,18 40,30 38,46
        L44,46
        L44,62
        L42,68
        L54,65
        L66,68
        L64,62
        L64,46
        L70,46
